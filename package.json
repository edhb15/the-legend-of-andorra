{
  "name": "the-legend-of-andorra",
  "private": true,
  "version": "1.0.0",
  "description": "THE LEGEND OF ANDORRA - a 3D open-world fantasy adventure built with Babylon.js on the real terrain of Andorra",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test tests/core.test.ts"
  },
  "dependencies": {
    "@babylonjs/core": "9.37.1",
    "@fontsource/cinzel": "5.3.0",
    "@fontsource/cinzel-decorative": "5.3.0",
    "@fontsource/eb-garamond": "5.3.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "7.3.8"
  }
}
